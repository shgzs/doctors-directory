{
  "name": "doctors-directory-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply doctors-directory --local",
    "db:migrate:remote": "wrangler d1 migrations apply doctors-directory --remote",
    "db:seed:local": "wrangler d1 execute doctors-directory --local --file=./seed.local.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^4.20241022.0"
  }
}
